# ─────────────────────────────────────────────────────────
# 复制成 .env 再填自己的。.env 已在 .gitignore 里，不会提交。
# ─────────────────────────────────────────────────────────

# ── 可选：Cloudflare Pages 自动发布 ──────────────────────
# 不填就只生成本地报告，不发布。填了才会上线。
# token 权限：Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=
# 在 CF 控制台右下角或 URL 里能找到
CLOUDFLARE_ACCOUNT_ID=
# Pages 项目名，第一次部署会自动创建
CF_PAGES_PROJECT=social-trend-radar

# ── 可选：HTTP 代理 ─────────────────────────────────────
# 国内网络抓国外源需要。留空则直连。
RADAR_HTTP_PROXY=

# ── 可选：论文讲解器的访问码 ────────────────────────────
# 留空 = 不设防，谁都能用（会消耗你自己的模型额度）
PAPER_ACCESS_CODE=

# ── 可选：LLM 端点（翻译 + 论文讲解）────────────────────
# 兼容 OpenAI 的 /v1/chat/completions 或 /v1/responses
# 留空 = 跳过翻译，报告只有原文
LLM_BASE=
LLM_KEY=
LLM_MODEL=

# ── 可选：YouTube Data API ──────────────────────────────
# 只有启用 youtube 源才需要
YOUTUBE_API_KEY=
